generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PASSENGER
  DRIVER
}

enum RideStatus {
  REQUESTED
  MATCHED
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED
}

enum PoolStatus {
  OPEN
  STARTED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle      Vehicle?
  rideRequests RideRequest[]

  @@index([role])
  @@map("users")
}

model Vehicle {
  id        String   @id @default(uuid()) @db.Uuid
  driverId  String   @unique @map("driver_id") @db.Uuid
  name      String   @db.VarChar(100)
  model     String   @db.VarChar(100)
  capacity  Int
  isOnline  Boolean  @default(false) @map("is_online")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  driver User   @relation(fields: [driverId], references: [id])
  pools  Pool[]

  @@index([isOnline])
  @@map("vehicles")
}

model RideRequest {
  id              String     @id @default(uuid()) @db.Uuid
  passengerId     String     @map("passenger_id") @db.Uuid
  pickupZone      String     @map("pickup_zone") @db.VarChar(100)
  destinationZone String     @map("destination_zone") @db.VarChar(100)
  pickupLat       Decimal?   @map("pickup_lat") @db.Decimal(9, 6)
  pickupLng       Decimal?   @map("pickup_lng") @db.Decimal(9, 6)
  destinationLat  Decimal?   @map("destination_lat") @db.Decimal(9, 6)
  destinationLng  Decimal?   @map("destination_lng") @db.Decimal(9, 6)
  seatsRequested  Int        @map("seats_requested")
  status          RideStatus @default(REQUESTED)
  requestedAt     DateTime   @default(now()) @map("requested_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  cancelledAt     DateTime?  @map("cancelled_at") @db.Timestamptz(6)
  completedAt     DateTime?  @map("completed_at") @db.Timestamptz(6)

  passenger     User                @relation(fields: [passengerId], references: [id])
  poolMember    PoolMember?
  statusHistory RideStatusHistory[]
  fare          Fare?

  @@index([passengerId])
  @@index([status])
  @@index([requestedAt])
  @@index([status, requestedAt])
  @@map("ride_requests")
}

model Pool {
  id          String     @id @default(uuid()) @db.Uuid
  vehicleId   String     @map("vehicle_id") @db.Uuid
  status      PoolStatus @default(OPEN)
  startedAt   DateTime?  @map("started_at") @db.Timestamptz(6)
  completedAt DateTime?  @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle Vehicle      @relation(fields: [vehicleId], references: [id])
  members PoolMember[]

  @@index([vehicleId])
  @@index([status])
  @@index([vehicleId, status])
  @@map("pools")
}

model PoolMember {
  id             String   @id @default(uuid()) @db.Uuid
  poolId         String   @map("pool_id") @db.Uuid
  rideRequestId  String   @unique @map("ride_request_id") @db.Uuid
  seatsAllocated Int      @map("seats_allocated")
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  pool        Pool        @relation(fields: [poolId], references: [id])
  rideRequest RideRequest @relation(fields: [rideRequestId], references: [id])

  @@unique([poolId, rideRequestId])
  @@index([poolId])
  @@map("pool_members")
}

model RideStatusHistory {
  id            String     @id @default(uuid()) @db.Uuid
  rideRequestId String     @map("ride_request_id") @db.Uuid
  status        RideStatus
  changedAt     DateTime   @default(now()) @map("changed_at") @db.Timestamptz(6)
  note          String?

  rideRequest RideRequest @relation(fields: [rideRequestId], references: [id])

  @@index([rideRequestId])
  @@index([rideRequestId, changedAt])
  @@map("ride_status_history")
}

model Fare {
  id             String   @id @default(uuid()) @db.Uuid
  rideRequestId  String   @unique @map("ride_request_id") @db.Uuid
  baseFare       BigInt   @map("base_fare")
  distanceCharge BigInt   @map("distance_charge")
  poolDiscount   BigInt   @map("pool_discount")
  totalFare      BigInt   @map("total_fare")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rideRequest RideRequest @relation(fields: [rideRequestId], references: [id])

  @@map("fares")
}
